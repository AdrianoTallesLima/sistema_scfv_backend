// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PerfilUsuario {
  ADMIN
  ORIENTADOR
}

enum ScfvActivity {
  SCFV_0_6
  SCFV_7_15
  SCFV_IDOSOS
}

enum DeactivationType {
  MANUAL
  AGE_LIMIT
}

enum ResponsibleRelationship {
  PAI
  MAE
  OUTRO
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  login        String        @unique
  senhaHash    String
  perfil       PerfilUsuario @default(ORIENTADOR)
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  createdScfvUsers ScfvUser[] @relation("ScfvUserCreatedBy")
  updatedScfvUsers ScfvUser[] @relation("ScfvUserUpdatedBy")
}

model ScfvUser {
  id Int @id @default(autoincrement())

  activity  ScfvActivity
  name      String
  cpf       String       @unique @db.VarChar(11)
  nis       String?      @db.VarChar(11)
  birthDate DateTime     @db.Date
  phone     String?      @db.VarChar(11)
  address   String?      @db.VarChar(200)

  photoPath String?

  active           Boolean           @default(true)
  deactivationType DeactivationType?
  inactiveReason   String?           @db.VarChar(100)
  inactiveAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById Int
  updatedById Int?

  createdBy Usuario @relation("ScfvUserCreatedBy", fields: [createdById], references: [id])

  updatedBy Usuario? @relation("ScfvUserUpdatedBy", fields: [updatedById], references: [id])

  childProfile   ChildProfile?
  elderlyProfile ElderlyProfile?

  @@index([active, activity])
}

model Responsible {
  id Int @id @default(autoincrement())

  name  String
  cpf   String  @unique @db.VarChar(11)
  phone String? @db.VarChar(11)

  childProfiles ChildProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChildProfile {
  id Int @id @default(autoincrement())

  scfvUserId Int      @unique
  scfvUser   ScfvUser @relation(fields: [scfvUserId], references: [id])

  responsibleId Int
  responsible   Responsible @relation(fields: [responsibleId], references: [id])

  relationship      ResponsibleRelationship
  relationshipOther String?                 @db.VarChar(50)

  school           String? @db.VarChar(150)
  grade            String? @db.VarChar(50)
  schoolClass      String? @db.VarChar(50)
  schoolAttendance String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([responsibleId])
}

model ElderlyProfile {
  id Int @id @default(autoincrement())

  scfvUserId Int      @unique
  scfvUser   ScfvUser @relation(fields: [scfvUserId], references: [id])

  situation    String? @db.VarChar(200)
  observations String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
